{
    "label" : "lock",
    "action" : "hyprlock",
    "text" : "Lock {l}",
    "keybind" : "l"
    "height" : 0.1
}
{
    "label" : "reboot",
    "action" : "hyprshutdown -t 'Rebooting...' --post-cmd 'systemctl reboot'",
    "text" : "Reboot {r}",
    "keybind" : "r"
    "height" : 0.1
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate {h}",
    "keybind" : "h"
    "height" : 0.1
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown -t 'Shutting down...' --post-cmd 'systemctl poweroff'",
    "text" : "Shutdown {s}",
    "keybind" : "s"
    "height" : 0.1
}
{
    "label" : "logout",
    "action" : "hyprshutdown -t 'Logging out...",
    "text" : "Logout {e}",
    "keybind" : "e"
    "height" : 0.1
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend {u}",
    "keybind" : "u"
    "height" : 0.1
}
